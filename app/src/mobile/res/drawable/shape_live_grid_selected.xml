<?xml version="1.0" encoding="utf-8"?>
<!-- 竖屏直播频道网格胶囊的选中态：琥珀实底。0.1.100 起由 ChannelGridAdapter 按 selectedPosition
     直接换底色，不经过 selector / selected 状态（0.1.99 的 selector 在真机上没让网格胶囊变色）。
     圆角 16dp：胶囊高 32dp，16dp 正好是半圆胶囊。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/live_selected" />
    <corners android:radius="16dp" />
</shape>
